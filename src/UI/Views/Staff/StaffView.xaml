<UserControl x:Class="UI.Views.StaffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:UI.Views"
             xmlns:components="clr-namespace:UI.Components.Staff"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:viewmodels="clr-namespace:UI.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:StaffViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
            Grid.ColumnSpan="3"
            Background="White"
            BorderBrush="#E5E5E5"
            BorderThickness="0,0,0,1">

            <Grid Margin="20,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="ESoft"
                       VerticalAlignment="Center"
                       FontSize="28"
                       FontWeight="Bold"/>

                <TextBox Grid.Column="1"
                     Height="40"
                     VerticalAlignment="Center"
                     materialDesign:HintAssist.Hint="Tìm kiếm sản phẩm" TextChanged="TextBox_TextChanged"/>

                <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">

                    <Button Click="HandleLogOutClick" Style="{StaticResource MaterialDesignIconButton}">
                        <materialDesign:PackIcon Kind="Logout"/>
                    </Button>

                </StackPanel>

            </Grid>

        </Border>

        <!-- Sidebar -->
        <Border Grid.Row="1"
            Grid.Column="0"
            BorderBrush="#E5E5E5"
            BorderThickness="0,0,1,0">

            <StackPanel Margin="15">

                <TextBlock Text="DANH MỤC"
                       FontWeight="Bold"
                       Margin="0,10"/>


                <ItemsControl ItemsSource="{Binding CategoryVM.Categories}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"
                       Margin="0,5"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>

        </Border>

        <!-- Product Area -->
        <ScrollViewer Grid.Row="1"
                  Grid.Column="1">

            <ItemsControl ItemsSource="{Binding Products}">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <components:CardProduct/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </ScrollViewer>

        <!-- Cart -->
        <Border Grid.Row="1"
            Grid.Column="2"
            Background="White"
            BorderBrush="#E5E5E5"
            BorderThickness="1,0,0,0" Margin="101,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="250"/>
                </Grid.RowDefinitions>
                <!-- Danh sách sản phẩm -->
                <ListBox ItemsSource="{Binding CartItems}"
                     Margin="15">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <components:CartItemComponent/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <!-- Tổng tiền -->
                <StackPanel Grid.Row="1"
                        Margin="20">
                    <TextBlock Text="Tổng tiền"/>
                    <TextBlock Text="Thuế"/>
                    <Separator/>
                    <TextBlock Text="Thành tiền"
                           FontSize="20"
                           FontWeight="Bold"/>
                    <Button Content="Checkout"
                        Margin="0,20,0,0"
                        Height="55"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
